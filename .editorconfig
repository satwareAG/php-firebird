root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{c,cpp,h}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{php,phpt}]
indent_style = space  
indent_size = 4
max_line_length = 120

[*.m4]
indent_style = space
indent_size = 2

[{Makefile*,*.mk}]
indent_style = tab
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
