// config.w32 - Windows build configuration for php-firebird extension
// PHP 8.2+ required, Firebird 3.0+ required
// Handles both firebird (--with-firebird) and pdo_fbird (--with-pdo-fbird)

ARG_WITH('firebird', 'Firebird database support', 'no');

if (PHP_FIREBIRD != 'no') {
    // js #672: version detection must work in every build layout:
    // - php-windows-builder / standalone phpize: CWD = extension repo root,
    //   which holds VERSION.txt (renamed from VERSION long ago - the old
    //   .\VERSION read silently fell back to "0.0.0-unknown" in every
    //   Windows release, see #672)
    // - buildconf --add-modules-dir layouts: CWD = php-src root, the module
    //   dir differs; configure_module_dirname points at the extension dir
    //   (guarded typeof: phpize-generated configure scripts may not set it)
    var version = "0.0.0-unknown";
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var modDir = (typeof configure_module_dirname != 'undefined') ? configure_module_dirname : null;
    var versionCandidates = [".\\VERSION.txt"];
    if (modDir) { versionCandidates.push(modDir + "\\VERSION.txt"); }
    versionCandidates.push(".\\VERSION");
    for (var vi = 0; vi < versionCandidates.length; vi++) {
        try {
            if (fso.FileExists(versionCandidates[vi])) {
                var vf = fso.OpenTextFile(versionCandidates[vi], 1);
                if (!vf.AtEndOfStream) {
                    version = vf.ReadLine().replace(/^\s+|\s+$/g, "");
                    STDOUT.WriteLine("Found php-firebird version: " + version + " (from " + versionCandidates[vi] + ")");
                }
                vf.Close();
                if (version != "0.0.0-unknown" && version != "0.0.0-empty") { break; }
            }
        } catch (e) {
            STDOUT.WriteLine("VERSION read failed for " + versionCandidates[vi] + ": " + e.message);
        }
    }
    // js #672 SSOT: fail loud - never build an unversioned DLL. The escape
    // env FBIRD_ALLOW_UNKNOWN_VERSION=1 is ignored on tag refs (GITHUB_REF
    // is set inside Actions; the builder task inherits it), where an unknown
    // version is always a defect; publish-release rejects unknown strings
    // regardless of this escape hatch.
    var semverRe = /^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.+-]+)?$/;
    var versionOk = semverRe.test(version) && version.indexOf("0.0.0") !== 0;
    if (!versionOk) {
        var shVer = new ActiveXObject("WScript.Shell");
        var allowUnknown = shVer.ExpandEnvironmentStrings("%FBIRD_ALLOW_UNKNOWN_VERSION%");
        var gitRef = shVer.ExpandEnvironmentStrings("%GITHUB_REF%");
        var onTagRef = (gitRef.indexOf("refs/tags/") === 0);
        if (onTagRef || allowUnknown != "1") {
            ERROR("php-firebird #672: version source missing or invalid (tried " +
                  versionCandidates.join(", ") + "). Refusing to build an " +
                  "unversioned binary. VERSION.txt must contain a semver string. " +
                  "Set FBIRD_ALLOW_UNKNOWN_VERSION=1 to override non-release builds.");
        }
        STDOUT.WriteLine("WARNING: building with unknown version (FBIRD_ALLOW_UNKNOWN_VERSION=1)");
    }

    // js #672: generate version_stamp.h for template.rc (PE FileVersion/
    // ProductVersion). Written next to the template so every build layout
    // stamps correctly; without it the PE defaults to the PHP runtime
    // version (every Windows DLL before 13.2.12 shipped that way).
    var stampDir = modDir ? modDir : ".";
    var stampPath = stampDir + "\\version_stamp.h";
    try {
        var vDigits = version.split(".");
        var vPatchNum = (String(vDigits[2]).match(/^\d+/) || ["0"])[0];
        var fvs = vDigits[0] + "," + vDigits[1] + "," + vPatchNum + ",0";
        var stampF = fso.CreateTextFile(stampPath, true);
        stampF.WriteLine("#define EXT_FILE_VERSION " + fvs);
        stampF.WriteLine("#define EXT_PRODUCT_VERSION " + fvs);
        stampF.WriteLine("#define EXT_VERSION \"" + version + "\"");
        stampF.Close();
        STDOUT.WriteLine("Wrote " + stampPath + " (EXT_VERSION " + version + ")");
    } catch (e) {
        ERROR("php-firebird issue 672: failed to write " + stampPath + ": " + e.message);
    }
    AC_DEFINE('PHP_FIREBIRD_VERSION_STRING', version, 'PHP Firebird extension version');

    // Check for Firebird client library and header.
    // Only fbclient_ms.lib (Firebird 3.0+) is supported.
    // gds32_ms.lib (Firebird 1.x era) is not supported and was removed in #179.
    if (CHECK_LIB('fbclient_ms.lib', 'firebird', PHP_FIREBIRD + '\\lib') &&
        CHECK_HEADER_ADD_INCLUDE('ibase.h', 'CFLAGS_FIREBIRD', PHP_FIREBIRD + '\\include')) {

        // Verify Firebird 3.0+ OO API availability (FB_API_VER >= 30)
        // The OO API header (firebird/Interface.h) is required for Firebird 3.0+
        if (!CHECK_HEADER_ADD_INCLUDE('firebird/Interface.h', 'CFLAGS_FIREBIRD', PHP_FIREBIRD + '\\include')) {
            ERROR('Firebird 3.0+ required: firebird/Interface.h not found. ' +
                  'This extension requires Firebird client 3.0 or later with OO API support.');
        }

        // Define all source files
        var firebird_sources = 'firebird.c ' +
                               'fbird_error.c ' +
                               'fbird_connection.c ' +
                               'fbird_transaction.c ' +
                               'fbird_batch.c ' +
                               'fbird_blobs.c ' +
                               'fbird_datetime.c ' +
                               'fbird_events.c ' +
                               'fbird_inspection.c ' +
                               'fbird_metadata.c ' +
                               'fbird_query_exec.c ' +
                               'fbird_query_prepare.c ' +
                               'fbird_query_bind.c ' +
                               'fbird_query_array.c ' +
                               'fbird_result.c ' +
                               'fbird_service.c ' +
                               'fbird_classes.c ' +
                               'fbird_class_connection.c ' +
                               'fbird_class_transaction.c ' +
                               'fbird_class_statement.c ' +
                               'fbird_class_resultset.c ' +
                               'fbird_class_blob.c ' +
                               'fbird_class_service.c ' +
                               'fbird_class_event.c ' +
                               'fbird_class_batch.c ' +
                               'fbird_class_decfloat.c ' +
                               'firebird_utils.cpp';

        // Register extension
        // /EHsc enables C++ exception handling (required for firebird_utils.cpp)
        EXTENSION('firebird', firebird_sources, PHP_FIREBIRD_SHARED,
                  '/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1 /EHsc /std:c++17');

        AC_DEFINE('HAVE_FIREBIRD', 1, 'Have Firebird support');

        // Note: fbclient.dll is a runtime dependency, not a build dependency
        // It must be in PATH or alongside the extension at runtime
        // DO NOT use ADD_FLAG('DEPS_FIREBIRD', 'fbclient.dll') as it causes nmake to fail

    } else {
        WARNING('firebird not enabled; Firebird client libraries and headers not found');
    }
}

// pdo_fbird — PDO driver for Firebird (fbird: DSN prefix)
// Separate extension, depends on firebird.so for fbc_*/fbt_*/fbs_* symbols
ARG_WITH('pdo-fbird', 'Firebird PDO driver (fbird: DSN)', 'no');

if (PHP_PDO_FBIRD != 'no') {
    if (CHECK_LIB('fbclient_ms.lib', 'pdo_fbird', PHP_PDO_FBIRD + '\\lib') &&
        CHECK_HEADER_ADD_INCLUDE('ibase.h', 'CFLAGS_PDO_FBIRD', PHP_PDO_FBIRD + '\\include')) {

        AC_DEFINE('HAVE_PDO_FBIRD', 1, 'pdo_fbird available');

        // js #672: pdo_fbird version - php_pdo_fbird.h falls back to
        // "0.0.0-unknown" unless the define comes from configure. The Linux
        // lane (config.m4) reads pdo_fbird/VERSION.txt; the Windows lane
        // never defined it at all, so every Windows pdo_fbird.dll reported
        // its build-time fallback.
        var pdoVersion = "0.0.0-unknown";
        try {
            var fsoPdo = new ActiveXObject("Scripting.FileSystemObject");
            var pdoVersionFile = ".\\pdo_fbird\\VERSION.txt";
            if (fsoPdo.FileExists(pdoVersionFile)) {
                var pf = fsoPdo.OpenTextFile(pdoVersionFile, 1);
                if (!pf.AtEndOfStream) {
                    pdoVersion = pf.ReadLine().replace(/^\s+|\s+$/g, "");
                    STDOUT.WriteLine("Found pdo_fbird version: " + pdoVersion);
                }
                pf.Close();
            }
        } catch (e) {
            STDOUT.WriteLine("pdo VERSION read failed: " + e.message);
        }
        // js #672 SSOT: same fail-loud contract as the firebird section.
        var pdoSemverRe = /^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.+-]+)?$/;
        var pdoVersionOk = pdoSemverRe.test(pdoVersion) && pdoVersion.indexOf("0.0.0") !== 0;
        if (!pdoVersionOk) {
            var shPdoVer = new ActiveXObject("WScript.Shell");
            var pdoAllowUnknown = shPdoVer.ExpandEnvironmentStrings("%FBIRD_ALLOW_UNKNOWN_VERSION%");
            var pdoGitRef = shPdoVer.ExpandEnvironmentStrings("%GITHUB_REF%");
            var pdoOnTagRef = (pdoGitRef.indexOf("refs/tags/") === 0);
            if (pdoOnTagRef || pdoAllowUnknown != "1") {
                ERROR("pdo_fbird #672: version source missing or invalid (tried " +
                      pdoVersionFile + "). Refusing to build an unversioned " +
                      "binary. pdo_fbird/VERSION.txt must contain a semver string. " +
                      "Set FBIRD_ALLOW_UNKNOWN_VERSION=1 to override non-release builds.");
            }
            STDOUT.WriteLine("WARNING: pdo_fbird building with unknown version (FBIRD_ALLOW_UNKNOWN_VERSION=1)");
        }
        AC_DEFINE('PHP_PDO_FBIRD_VERSION', pdoVersion, 'pdo_fbird extension version');

        // Source files: use flattened names if available (Windows build
        // pre-copies them to root to avoid subdirectory output dir issues),
        // otherwise use the pdo_fbird/ subdirectory prefix.
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var useFlat = fso.FileExists("pdo_fbird_root.c");
        var pdo_fbird_sources;
        if (useFlat) {
            pdo_fbird_sources = 'pdo_fbird_root.c ' +
                                'pdo_fbird_driver.c ' +
                                'pdo_fbird_stmt.c ' +
                                'pdo_fbird_error.c';
        } else {
            pdo_fbird_sources = 'pdo_fbird/pdo_fbird.c ' +
                                'pdo_fbird/pdo_fbird_driver.c ' +
                                'pdo_fbird/pdo_fbird_stmt.c ' +
                                'pdo_fbird/pdo_fbird_error.c';
        }

        EXTENSION('pdo_fbird', pdo_fbird_sources, PHP_PDO_FBIRD_SHARED,
                  '/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1 /EHsc /std:c++17');

        // jane #636: cross-DLL link dependency. pdo_fbird.dll imports the
        // fbc_/fbt_/fbs_* layer from php_firebird.dll (built in the same
        // tree, same BUILD_DIR). Mirrors ADD_EXTENSION_DEP's wiring from
        // win32/build/confutils.js (phpize mode points BUILD_DIR_DEV, which
        // does not hold sibling-extension libs, so wire it explicitly):
        //   LIBS_*   -> link input
        //   LDFLAGS_* -> /libpath
        //   DEPS_*   -> nmake build order (firebird dll links first)
        ADD_FLAG('LIBS_PDO_FBIRD', 'php_firebird.lib');
        ADD_FLAG('LDFLAGS_PDO_FBIRD', '/libpath:$(BUILD_DIR)');
        ADD_FLAG('DEPS_PDO_FBIRD', '$(BUILD_DIR)\\php_firebird.lib');

    } else {
        WARNING('pdo_fbird not enabled; Firebird client libraries and headers not found');
    }
}
