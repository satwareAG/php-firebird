// vim:ft=javascript

ARG_WITH("firebird", "Firebird support", "no");

if (PHP_FIREBIRD != "no") {
	if (
		CHECK_HEADER_ADD_INCLUDE("ibase.h", "CFLAGS_FIREBIRD", PHP_FIREBIRD + "\\include") && (
			CHECK_LIB("fbclient_ms.lib", "firebird", PHP_FIREBIRD + "\\lib") ||
			CHECK_LIB("gds32_ms.lib", "firebird", PHP_FIREBIRD + "\\lib")
		)
	) {
		EXTENSION("firebird", "firebird.c ibase_query_exec.c ibase_result.c ibase_metadata.c ibase_service.c ibase_events.c ibase_blobs.c firebird_utils.cpp", PHP_FIREBIRD_SHARED, "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");
		AC_DEFINE('HAVE_FIREBIRD', 1, 'Have interbase library');
	} else {
		WARNING("interbase not enabled; libraries and headers not found");
	}
}
