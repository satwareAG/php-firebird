// config.w32 - Windows build configuration for php-firebird extension
// PHP 8.1+ required, Firebird 3.0+ required

ARG_WITH('firebird', 'Firebird database support', 'no');

if (PHP_FIREBIRD != 'no') {
    // Detect php-firebird version from VERSION file
    var version = "0.0.0-unknown";
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var versionFile = ".\\VERSION";
        if (fso.FileExists(versionFile)) {
            var f = fso.OpenTextFile(versionFile, 1);
            version = f.AtEndOfStream ? "0.0.0-empty" : f.ReadLine().replace(/^\s+|\s+$/g, "");
            f.Close();
            STDOUT.WriteLine("Found php-firebird version: " + version);
        } else {
            STDOUT.WriteLine("VERSION file not found at " + fso.GetAbsolutePathName(versionFile));
        }
    } catch (e) {
        STDOUT.WriteLine("Error reading VERSION file: " + e.message);
    }
    AC_DEFINE('PHP_FIREBIRD_VERSION_STRING', version, 'PHP Firebird extension version');

    // Check for Firebird client library and header.
    // Only fbclient_ms.lib (Firebird 3.0+) is supported.
    // gds32_ms.lib (Firebird 1.x era) is not supported and was removed in #179.
    if (CHECK_LIB('fbclient_ms.lib', 'firebird', PHP_FIREBIRD + '\\lib') &&
        CHECK_HEADER_ADD_INCLUDE('ibase.h', 'CFLAGS_FIREBIRD', PHP_FIREBIRD + '\\include')) {

        // Verify Firebird 3.0+ OO API availability (FB_API_VER >= 30)
        // The OO API header (firebird/Interface.h) is required for Firebird 3.0+
        if (!CHECK_HEADER_ADD_INCLUDE('firebird/Interface.h', 'CFLAGS_FIREBIRD', PHP_FIREBIRD + '\\include')) {
            ERROR('Firebird 3.0+ required: firebird/Interface.h not found. ' +
                  'This extension requires Firebird client 3.0 or later with OO API support.');
        }

        // Define all source files
        var firebird_sources = 'firebird.c ' +
                               'fbird_error.c ' +
                               'fbird_connection.c ' +
                               'fbird_transaction.c ' +
                               'fbird_batch.c ' +
                               'fbird_blobs.c ' +
                               'fbird_datetime.c ' +
                               'fbird_events.c ' +
                               'fbird_inspection.c ' +
                               'fbird_metadata.c ' +
                               'fbird_query_exec.c ' +
                               'fbird_query_prepare.c ' +
                               'fbird_query_bind.c ' +
                               'fbird_query_array.c ' +
                               'fbird_result.c ' +
                               'fbird_service.c ' +
                               'fbird_classes.c ' +
                               'firebird_utils.cpp';

        // Register extension
        // /EHsc enables C++ exception handling (required for firebird_utils.cpp)
        EXTENSION('firebird', firebird_sources, PHP_FIREBIRD_SHARED,
                  '/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1 /EHsc /std:c++17');

        AC_DEFINE('HAVE_FIREBIRD', 1, 'Have Firebird support');

        // Note: fbclient.dll is a runtime dependency, not a build dependency
        // It must be in PATH or alongside the extension at runtime
        // DO NOT use ADD_FLAG('DEPS_FIREBIRD', 'fbclient.dll') as it causes nmake to fail

    } else {
        WARNING('firebird not enabled; Firebird client libraries and headers not found');
    }
}
