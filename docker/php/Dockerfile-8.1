# Base stage with common dependencies
FROM php:8.1-cli AS base

# Install dependencies in a single layer to reduce image size
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    build-essential \
    firebird-dev \
    g++ \
    gcc \
    gdb \
    git \
    lcov \
    libtool \
    libxml2-dev \
    make \
    re2c \
    unzip \
    valgrind \
    vim \
    wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    # Link Firebird client libraries
    && if [ ! -f /usr/lib/libfbclient.so ] && [ -f /usr/lib/x86_64-linux-gnu/libfbclient.so ]; then \
       ln -s /usr/lib/x86_64-linux-gnu/libfbclient.so /usr/lib/libfbclient.so; \
    fi

# Development stage
FROM base AS dev

# Install Xdebug in a separate layer
RUN pecl channel-update pecl.php.net \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug

# Configure PHP for development
COPY php-dev.ini /usr/local/etc/php/conf.d/php-dev.ini
COPY xdebug.ini /usr/local/etc/php/conf.d/xdebug.ini

# Set working directory
WORKDIR /ext

# Use a non-privileged user for better security
RUN groupadd -g 1000 phpdev && \
    useradd -u 1000 -g phpdev -s /bin/bash -m phpdev && \
    chown -R phpdev:phpdev /ext

USER phpdev

# Default command
CMD ["php", "-a"]
