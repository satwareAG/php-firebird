# PHP 8.2 with Firebird 5.x Client Library
FROM php:8.2-cli AS base

RUN apt-get update && apt-get install -y \
    autoconf build-essential gcc g++ make libtool bison re2c libicu-dev libxml2-dev \
    git unzip wget tzdata vim gdb valgrind lcov libncurses6 libtommath1 jq curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN set -eux && \
    mkdir -p /opt/firebird && cd /tmp && \
    TAG=$(curl -s https://api.github.com/repos/FirebirdSQL/firebird/releases | jq -r '.[] | select(.tag_name | test("^v5\\.")) | .tag_name' | head -n 1) && \
    ASSET_URL=$(curl -s https://api.github.com/repos/FirebirdSQL/firebird/releases/tags/${TAG} | jq -r '.assets[] | select(.name | test("linux-x64\\.tar\\.gz$") and (test("debug") | not)) | .browser_download_url' | head -n 1) && \
    ASSET_NAME=$(basename "${ASSET_URL}") && \
    wget -q -O firebird.tar.gz "${ASSET_URL}" && \
    tar xf firebird.tar.gz && \
    EXTRACT_DIR="${ASSET_NAME%.tar.gz}" && \
    tar xf "${EXTRACT_DIR}/buildroot.tar.gz" -C /opt/firebird --strip-components=3 && \
    rm -rf /tmp/Firebird-* /tmp/firebird.tar.gz && ldconfig

RUN ln -sf /opt/firebird/lib/libfbclient.so /usr/lib/libfbclient.so \
    && ln -sf /opt/firebird/lib/libfbclient.so.2 /usr/lib/libfbclient.so.2 \
    && ln -sf /opt/firebird/include /usr/include/firebird \
    && echo "/opt/firebird/lib" > /etc/ld.so.conf.d/firebird.conf \
    && ldconfig && docker-php-ext-install pdo pcntl

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV FIREBIRD=/opt/firebird FIREBIRD_HOME=/opt/firebird LD_LIBRARY_PATH=/opt/firebird/lib:$LD_LIBRARY_PATH
ENTRYPOINT ["/entrypoint.sh"]
CMD ["php", "-a"]
