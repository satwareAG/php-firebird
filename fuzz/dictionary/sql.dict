# Firebird SQL Fuzz Dictionary
# Format: AFL/libFuzzer compatible - one token per line, optionally quoted
# Used by fuzz/run.php --dictionary= option
#
# Categories:
#   - DDL keywords
#   - DML keywords
#   - Clauses and operators
#   - Firebird-specific keywords
#   - Data types
#   - Built-in functions
#   - Special characters and delimiters
#   - Edge-case strings

# --- DDL Keywords ---
"SELECT"
"INSERT"
"UPDATE"
"DELETE"
"CREATE"
"ALTER"
"DROP"
"GRANT"
"REVOKE"
"EXECUTE"
"MERGE"
"RECREATE"

# --- Table/Object DDL ---
"TABLE"
"VIEW"
"INDEX"
"TRIGGER"
"PROCEDURE"
"FUNCTION"
"GENERATOR"
"SEQUENCE"
"DOMAIN"
"EXCEPTION"
"ROLE"
"DATABASE"
"SCHEMA"
"PACKAGE"
"PACKAGE BODY"

