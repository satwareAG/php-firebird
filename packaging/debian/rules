#!/usr/bin/make -f
# =============================================================================
# Debian packaging rules for php-firebird
# =============================================================================
# 
# This rules file builds php-firebird for ONE PHP version at a time.
# The build.sh script invokes dpkg-buildpackage once per PHP version.
#
# The FB5 client is bundled (not system firebird-dev) so that
# #if FB_API_VER >= 40 code paths are always enabled.
# =============================================================================

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# PHP version is passed via environment variable (PHP_VERSION=8.4)
# Default to 8.4 if not set
PHP_VERSION ?= 8.4
PHP_VER_SHORT := $(subst .,,$(PHP_VERSION))

# Firebird client directory (bundled by fetch-client.sh)
FB_ROOT ?= /opt/firebird

# Extension directory: use Debian convention /usr/lib/php/{API_VERSION}/
# jane: php-config --extension-dir returns Docker path (e.g.
#       /usr/local/lib/php/extensions/no-debug-non-zts-20240924), but
#       the .deb package should use the Debian path (/usr/lib/php/20240924/).
#       We extract just the API version number and construct the Debian path.
PHP_API_VERSION := $(shell $${PHPCONFIG:-php-config} --extension-dir 2>/dev/null | grep -oE '[0-9]+$$' || echo $(PHP_VERSION))
EXT_DIR := /usr/lib/php/$(PHP_API_VERSION)

%:
	dh $@

# =============================================================================
# Build target: compile the extension
# jane: build.sh already runs phpize + configure + make before invoking
#       dpkg-buildpackage. This target checks if the .so files exist and
#       skips the build if they do. This avoids the phpize8.4 vs phpize
#       naming issue (Docker uses unversioned, system uses versioned).
# =============================================================================
override_dh_auto_build:
	@if [ ! -f modules/firebird.so ]; then \
		echo "firebird.so not found - building..."; \
		PHPIZE=$$(command -v phpize$(PHP_VERSION) 2>/dev/null || command -v phpize); \
		PHPCONFIG=$$(command -v php-config$(PHP_VERSION) 2>/dev/null || command -v php-config); \
		$$PHPIZE && \
		./configure --with-php-config=$$PHPCONFIG --with-firebird=$(FB_ROOT) && \
		$(MAKE) -j$$(nproc); \
	else \
		echo "firebird.so already built (by build.sh) - skipping"; \
	fi

	@if [ ! -f pdo_fbird/modules/pdo_fbird.so ]; then \
		echo "pdo_fbird.so not found - building..."; \
		PHPIZE=$$(command -v phpize$(PHP_VERSION) 2>/dev/null || command -v phpize); \
		PHPCONFIG=$$(command -v php-config$(PHP_VERSION) 2>/dev/null || command -v php-config); \
		cd pdo_fbird && $$PHPIZE && \
		./configure --with-php-config=$$PHPCONFIG --with-firebird=$(FB_ROOT) && \
		$(MAKE) -j$$(nproc); \
	else \
		echo "pdo_fbird.so already built (by build.sh) - skipping"; \
	fi

# =============================================================================
# Install target: copy files directly to the binary package directory.
# jane: uses Make variables $(PHP_VERSION) directly (not shell variables)
#       because each recipe line runs in a separate shell.
# =============================================================================
override_dh_auto_install:
	PKG_DIR=debian/php$(PHP_VERSION)-firebird; \
	mkdir -p $${PKG_DIR}/$(EXT_DIR) \
		$${PKG_DIR}/usr/share/php/Firebird \
		$${PKG_DIR}/usr/lib/php-firebird \
		$${PKG_DIR}/etc/php/$(PHP_VERSION)/mods-available; \
	cp modules/firebird.so $${PKG_DIR}/$(EXT_DIR)/; \
	cp pdo_fbird/modules/pdo_fbird.so $${PKG_DIR}/$(EXT_DIR)/; \
	cp src/Firebird/*.php $${PKG_DIR}/usr/share/php/Firebird/; \
	cp packaging/firebird-autoload.php $${PKG_DIR}/usr/share/php/Firebird/; \
	cp -a $(FB_ROOT)/lib/libfbclient.so* $${PKG_DIR}/usr/lib/php-firebird/; \
	cp -a $(FB_ROOT)/lib/libicu*.so* $${PKG_DIR}/usr/lib/php-firebird/ 2>/dev/null || true; \
	cp -a $(FB_ROOT)/lib/libtomcrypt.so* $${PKG_DIR}/usr/lib/php-firebird/ 2>/dev/null || true; \
	cp -a $(FB_ROOT)/lib/libtommath.so* $${PKG_DIR}/usr/lib/php-firebird/ 2>/dev/null || true; \
	cp -a $(FB_ROOT)/lib/libre2.so* $${PKG_DIR}/usr/lib/php-firebird/ 2>/dev/null || true; \
	patchelf --force-rpath --set-rpath '$$ORIGIN/../../php-firebird' $${PKG_DIR}/$(EXT_DIR)/firebird.so; \
	patchelf --force-rpath --set-rpath '$$ORIGIN/../../php-firebird' $${PKG_DIR}/$(EXT_DIR)/pdo_fbird.so; \
	for lib in $${PKG_DIR}/usr/lib/php-firebird/*.so*; do \
		if [ -f "$$lib" ] && [ ! -L "$$lib" ]; then \
			patchelf --force-rpath --set-rpath '$$ORIGIN' "$$lib" 2>/dev/null || true; \
		fi; \
	done; \
	echo "extension=firebird.so" > $${PKG_DIR}/etc/php/$(PHP_VERSION)/mods-available/20-firebird.ini; \
	echo "extension=pdo_fbird.so" > $${PKG_DIR}/etc/php/$(PHP_VERSION)/mods-available/20-pdo_fbird.ini

# =============================================================================
# Skip auto-test (PHPT tests require a running Firebird server)
# =============================================================================
override_dh_auto_test:

# =============================================================================
# Skip dwz (DWARF optimization) - bundled FB5 client libs don't have debug info
# jane: dh_dwz fails on libfbclient.so and firebird.so with ".debug_info section
#       not present". These are pre-compiled binaries, not built with -g.
# =============================================================================
override_dh_dwz:

# =============================================================================
# Clean target
# =============================================================================
override_dh_auto_clean:
	-$(MAKE) clean 2>/dev/null || true
	-cd pdo_fbird && $(MAKE) clean 2>/dev/null || true
	-phpize$(PHP_VERSION) --clean 2>/dev/null || true
	-cd pdo_fbird && phpize$(PHP_VERSION) --clean 2>/dev/null || true
	dh_auto_clean
