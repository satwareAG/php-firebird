parameters:
    # Maximum analysis level (strictest)
    level: 8

    # Paths to analyze
    paths:
        - src/

    # Stub files for C extension function signatures
    stubFiles:
        - phpstan/fbird.stub.php

    # Bootstrap files to define extension constants
    bootstrapFiles:
        - phpstan/fbird-bootstrap.php

    # PHP version to analyze for
    phpVersion: 80100

    # Treat phpt files' PHP code specially (optional future)
    # excludePaths:
    #     - tests/*.phpt

    # Report unmatched ignores
    reportUnmatchedIgnoredErrors: false

    # Type coverage tracking
    treatPhpDocTypesAsCertain: false

    # Strict rules (level 8 enables most strict checks automatically)
    checkUninitializedProperties: true

    # Ignore patterns for extension-specific code (C extension provides these)
    ignoreErrors:
        # Extension-provided classes (stubs provide functions/constants, not Event class yet)
        - '#^Class Firebird\\Event not found\.$#'
        # Variadic functions have flexible parameter counts - handled by the C extension
        - '#^Function fbird_prepare invoked with \d+ parameters?, \d+ required\.$#'
        - '#^Function fbird_blob_create invoked with \d+ parameters?, \d+-?\d* required\.$#'
        - '#^Function fbird_blob_open invoked with \d+ parameters?, \d+ required\.$#'
        # Functions provided by C extension but stubs may not be fully recognized
        - '#^Function fbird_poll_event not found\.$#'
        - '#^Function fbird_trans_start not found\.$#'
        # Properties that exist for potential future use
        - '#^Property Firebird\\Database::\$username is never read, only written\.$#'
        # Type strictness for optional parameters in wrapper classes
        - message: '#^Parameter .* expects (resource|string|callable).*, .*(resource|string|callable).*\|null given\.$#'
          path: src/Firebird/FiberEventPoller.php
        # Property type assignments in signal handlers
        - message: '#^Property .* does not accept bool\.$#'
          path: src/Firebird/PcntlEventPoller.php
        - message: '#^Property .* is never assigned .* so it can be removed from the property type\.$#'
          path: src/Firebird/PcntlEventPoller.php
        # Runtime checks for pcntl functions
        - message: '#^Call to function function_exists\(\) .* will always evaluate to true\.$#'
          path: src/Firebird/PcntlEventPoller.php
        - message: '#^If condition is always false\.$#'
          path: src/Firebird/PcntlEventPoller.php
        - message: '#^Parameter .* of function pcntl_signal expects .*, bool given\.$#'
          path: src/Firebird/PcntlEventPoller.php
