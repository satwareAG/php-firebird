# Local development overrides - copy to docker-compose.override.yml and customize
name: php-firebird-dev

services:
  php81-dev:
    # Mount host caches to speed up package installations
    volumes:
      - ${HOME}/.composer:/home/phpdev/.composer
    environment:
      - PHP_IDE_CONFIG=serverName=php-firebird-dev
      # Customize other environment variables here

  # Similar overrides can be added for other services
