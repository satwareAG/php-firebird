--TEST--
Coverage: Parameter binding edge cases (INT64, Empty String, Large Blob)
--EXTENSIONS--
firebird
--SKIPIF--
<?php include __DIR__ . '/../firebird.inc'; ?>
--FILE--
<?php
require __DIR__ . '/../firebird.inc';

$dbh = fbird_connect($test_base);

// Create table
fbird_query($dbh, "RECREATE TABLE test_bind_edge (
    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    val_bigint BIGINT,
    val_varchar VARCHAR(100),
    val_blob BLOB SUB_TYPE TEXT
)");
fbird_commit($dbh);

// Test 1: INT64 Limits
echo "Test 1: INT64 Limits\n";
$sql = "INSERT INTO test_bind_edge (val_bigint) VALUES (?)";
$prep = fbird_prepare($dbh, $sql);

// PHP_INT_MAX on 64-bit is usually 9223372036854775807 (matches Firebird BIGINT)
$max = PHP_INT_MAX;
$min = PHP_INT_MIN;

fbird_execute($prep, $max);
fbird_execute($prep, $min);

// Test 2: Empty String
echo "Test 2: Empty String\n";
$sql = "INSERT INTO test_bind_edge (val_varchar) VALUES (?)";
$prep = fbird_prepare($dbh, $sql);
fbird_execute($prep, "");
fbird_execute($prep, "   "); // Spaces

// Test 3: Large String (Blob)
echo "Test 3: Large String\n";
$sql = "INSERT INTO test_bind_edge (val_blob) VALUES (?)";
$prep = fbird_prepare($dbh, $sql);
$large_str = str_repeat("A", 10000); // 10KB
fbird_execute($prep, $large_str);

// Test 4: Explicit NULL
echo "Test 4: Explicit NULL\n";
$sql = "INSERT INTO test_bind_edge (val_bigint, val_varchar) VALUES (?, ?)";
$prep = fbird_prepare($dbh, $sql);
fbird_execute($prep, null, null);

// Verify
$res = fbird_query($dbh, "SELECT * FROM test_bind_edge ORDER BY id");
while ($row = fbird_fetch_assoc($res)) {
    // Handle blob
    if (is_string($row['VAL_BLOB']) && strpos($row['VAL_BLOB'], '0x') !== 0) { // Assuming blob ID is string
        $blob_handle = fbird_blob_open($dbh, $row['VAL_BLOB']);
        if ($blob_handle) {
            $blob_info = fbird_blob_info($blob_handle);
            $content = "";
            if ($blob_info[0] > 0) {
                 $content = fbird_blob_get($blob_handle, $blob_info[0]);
            }
            $row['VAL_BLOB'] = strlen($content) . " bytes";
            fbird_blob_close($blob_handle);
        }
        //$row['VAL_BLOB'] = "BLOB FOUND";
    }
    var_dump($row);
}

fbird_close($dbh);
echo "Done\n";
?>
--EXPECTF--
Test 1: INT64 Limits
Test 2: Empty String
Test 3: Large String
Test 4: Explicit NULL
array(4) {
  ["ID"]=>
  int(%d)
  ["VAL_BIGINT"]=>
  int(9223372036854775807)
  ["VAL_VARCHAR"]=>
  NULL
  ["VAL_BLOB"]=>
  NULL
}
array(4) {
  ["ID"]=>
  int(%d)
  ["VAL_BIGINT"]=>
  int(-9223372036854775808)
  ["VAL_VARCHAR"]=>
  NULL
  ["VAL_BLOB"]=>
  NULL
}
array(4) {
  ["ID"]=>
  int(%d)
  ["VAL_BIGINT"]=>
  NULL
  ["VAL_VARCHAR"]=>
  string(0) ""
  ["VAL_BLOB"]=>
  NULL
}
array(4) {
  ["ID"]=>
  int(%d)
  ["VAL_BIGINT"]=>
  NULL
  ["VAL_VARCHAR"]=>
  string(3) "   "
  ["VAL_BLOB"]=>
  NULL
}
array(4) {
  ["ID"]=>
  int(%d)
  ["VAL_BIGINT"]=>
  NULL
  ["VAL_VARCHAR"]=>
  NULL
  ["VAL_BLOB"]=>
  string(11) "10000 bytes"
}
array(4) {
