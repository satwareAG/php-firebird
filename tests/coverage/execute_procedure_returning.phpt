--TEST--
Coverage: fbird_query_bind.c _php_fbird_safe_copy_sqlvar_data via DML RETURNING
--EXTENSIONS--
firebird
--SKIPIF--
<?php include __DIR__ . '/../skipif.inc'; ?>
--FILE--
<?php
require __DIR__ . '/../firebird.inc';

$dbh = fbird_connect($test_base);
if (!$dbh) die("connect failed: " . fbird_errmsg());

// Setup table
fbird_query($dbh, "EXECUTE BLOCK AS BEGIN
  IF (EXISTS(SELECT 1 FROM RDB\$RELATIONS WHERE RDB\$RELATION_NAME = 'PROC_COV')) THEN
    EXECUTE STATEMENT 'DROP TABLE PROC_COV';
END");
fbird_commit($dbh);

fbird_query($dbh, '
    CREATE TABLE PROC_COV (
        ID        INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        TITLE     VARCHAR(50),
        FIXCODE   CHAR(3),
        CREATED   DATE DEFAULT CURRENT_DATE,
        STAMP     TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        SCORE     DOUBLE PRECISION
    )');
fbird_commit($dbh);

// Test 1: INSERT...RETURNING with VARCHAR, CHAR, DOUBLE — triggers _php_fbird_safe_copy_sqlvar_data
echo "Test 1: INSERT RETURNING VARCHAR/CHAR/DOUBLE\n";
$ins = fbird_prepare($dbh, 'INSERT INTO PROC_COV (TITLE, FIXCODE, SCORE) VALUES (?, ?, ?) RETURNING ID, TITLE, FIXCODE, SCORE');
$q = fbird_execute($ins, 'Alpha', 'AAA', 1.5);
var_dump($q !== false);
if ($q !== false) {
    $row = fbird_fetch_row($q);
    var_dump($row !== false);
    var_dump(trim($row[1]) === 'Alpha');
    var_dump(trim($row[2]) === 'AAA');
    var_dump((float)$row[3] === 1.5);
    fbird_free_result($q);
}
fbird_commit($dbh);

// Test 2: INSERT...RETURNING with DATE, TIMESTAMP — triggers date/timestamp copy paths
echo "Test 2: INSERT RETURNING DATE/TIMESTAMP\n";
$ins2 = fbird_prepare($dbh, 'INSERT INTO PROC_COV (TITLE, SCORE) VALUES (?, ?) RETURNING ID, CREATED, STAMP');
$q = fbird_execute($ins2, 'Beta', 2.5);
var_dump($q !== false);
if ($q !== false) {
    $row = fbird_fetch_row($q);
    var_dump($row !== false);
    var_dump($row[1] !== null);  // DATE came back
    var_dump($row[2] !== null);  // TIMESTAMP came back
    fbird_free_result($q);
}
fbird_commit($dbh);

// Test 3: UPDATE...RETURNING to cover update-then-return paths
echo "Test 3: UPDATE RETURNING\n";
$upd = fbird_prepare($dbh, 'UPDATE PROC_COV SET SCORE = ? WHERE TITLE = ? RETURNING ID, TITLE, SCORE');
$q = fbird_execute($upd, 99.9, 'Alpha');
var_dump($q !== false);
if ($q !== false) {
    $row = fbird_fetch_row($q);
    var_dump($row !== false);
    var_dump((float)$row[2] === 99.9);
    fbird_free_result($q);
}
fbird_commit($dbh);

// Test 4: INSERT RETURNING with NULL values (covers NULL indicator path)
echo "Test 4: INSERT RETURNING with NULL\n";
$ins3 = fbird_prepare($dbh, 'INSERT INTO PROC_COV (TITLE, FIXCODE, SCORE) VALUES (?, ?, ?) RETURNING ID, TITLE, FIXCODE');
$q = fbird_execute($ins3, 'Gamma', null, null);
var_dump($q !== false);
if ($q !== false) {
    $row = fbird_fetch_row($q);
    var_dump($row !== false);
    var_dump(trim($row[1]) === 'Gamma');
    var_dump($row[2] === null);  // NULL CHAR
    fbird_free_result($q);
}
fbird_commit($dbh);

// Cleanup
@fbird_commit($dbh);
@fbird_query($dbh, 'DROP TABLE PROC_COV');
@fbird_commit($dbh);
fbird_close($dbh);

echo "Done\n";
?>
--EXPECT--
Test 1: INSERT RETURNING VARCHAR/CHAR/DOUBLE
bool(true)
bool(true)
bool(true)
bool(true)
bool(true)
Test 2: INSERT RETURNING DATE/TIMESTAMP
bool(true)
bool(true)
bool(true)
bool(true)
Test 3: UPDATE RETURNING
bool(true)
bool(true)
bool(true)
Test 4: INSERT RETURNING with NULL
bool(true)
bool(true)
bool(true)
bool(true)
Done
--CLEAN--
<?php require_once __DIR__ . '/../clean.inc'; ?>
