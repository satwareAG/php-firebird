--TEST--
Coverage: Complex array binding in fbird_query/fbird_execute
--EXTENSIONS--
firebird
--SKIPIF--
<?php include __DIR__ . '/../firebird.inc'; ?>
--FILE--
<?php
require __DIR__ . '/../firebird.inc';

$dbh = fbird_connect($test_base);

// Create a table for testing array inputs
fbird_query($dbh, "RECREATE TABLE test_array_complex (
    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    val_int INT,
    val_str VARCHAR(50),
    val_blob BLOB SUB_TYPE TEXT
)");
fbird_commit($dbh);

// Test 1: Array with NULLs
echo "Test 1: Array with NULLs\n";
$sql = "INSERT INTO test_array_complex (val_int, val_str) VALUES (?, ?)";
$prep = fbird_prepare($dbh, $sql);
$res = fbird_execute($prep, 1, null);
var_dump($res);

$res = fbird_execute($prep, null, "test");
var_dump($res);

// Test 2: Array with mixed types (implicit conversion)
echo "Test 2: Array with mixed types\n";
$res = fbird_execute($prep, "123", 456); // String to Int, Int to String
var_dump($res);

// Test 3: Invalid array structure (too many args)
echo "Test 3: Too many arguments\n";
// Note: fbird_execute emits a Notice/Warning but might still execute or return false
$res = @fbird_execute($prep, 1, "test", "extra");
if ($res === false) {
    echo "Caught expected error: Argument count mismatch\n";
} else {
    // If it succeeds, it ignores extra args?
    echo "Executed with extra args\n";
}

// Test 4: Invalid array structure (too few args)
echo "Test 4: Too few arguments\n";
$res = @fbird_execute($prep, 1);
if ($res === false) {
    echo "Caught expected error: Argument count mismatch\n";
} else {
    echo "Executed with missing args\n";
}

// Verify data
$res = fbird_query($dbh, "SELECT val_int, val_str, val_blob FROM test_array_complex ORDER BY id");
while ($row = fbird_fetch_assoc($res)) {
    var_dump($row);
}

fbird_close($dbh);
echo "Done\n";
?>
--EXPECTF--
Test 1: Array with NULLs
int(1)
int(1)
Test 2: Array with mixed types
int(1)
Test 3: Too many arguments
Executed with extra args
Test 4: Too few arguments
Caught expected error: Argument count mismatch
array(3) {
  ["VAL_INT"]=>
  int(1)
  ["VAL_STR"]=>
  NULL
  ["VAL_BLOB"]=>
  NULL
}
array(3) {
  ["VAL_INT"]=>
  NULL
  ["VAL_STR"]=>
  string(4) "test"
  ["VAL_BLOB"]=>
  NULL
}
array(3) {
  ["VAL_INT"]=>
  int(123)
  ["VAL_STR"]=>
  string(3) "456"
  ["VAL_BLOB"]=>
  NULL
}
array(3) {
  ["VAL_INT"]=>
  int(1)
  ["VAL_STR"]=>
  string(4) "test"
  ["VAL_BLOB"]=>
  NULL
}
Done
